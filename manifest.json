{
  "manifest_version": 3,
  "name": "Page to Summary Speech",
  "description": "閲覧中のWebページをAIで要約し、音声で読み上げます",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_title": "Page to Summary Speech"
  }
}